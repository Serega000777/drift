<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the engine-free DriftCareer.Core assembly and its EditMode tests outside Unity,
    so physics/gameplay logic can be verified on CI or any machine with the .NET SDK:
      dotnet test tools/CoreTests
    LangVersion is pinned to 9.0 to match Unity 6 C# support.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <DefineConstants>$(DefineConstants);DRIFT_CORE_TESTS</DefineConstants>
    <RootNamespace>DriftCareer.CoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/_DriftCareer/Core/**/*.cs" />
    <Compile Include="../../UnityProject/Assets/_DriftCareer/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
